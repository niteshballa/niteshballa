---
import type { HTMLAttributes } from "astro/types";
import { SITE } from "@/config";

const year = new Date().getFullYear();

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["site-footer", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <p class="fmeta">© {year} {SITE.author}</p>
</footer>

<style>
  .site-footer {
    width: 100%;
    max-width: 1040px;
    margin-inline: auto;
    padding: clamp(1.6rem, 4vw, 2.5rem) clamp(1rem, 4vw, 2rem);
  }
  .fmeta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: center;
  }
</style>
