---
import FormattedDate from './FormattedDate.astro'
import readingTime from 'reading-time'
import { excerpt } from '../lib/excerpt'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'posts'>
}
const { post } = Astro.props
const { title, published, tags } = post.data
const minutes = Math.max(1, Math.round(readingTime(post.body ?? '').minutes))
const summary = excerpt(post)
---
<article class="post-card">
  <a class="post-card-link" href={`/posts/${post.id}`}>
    <p class="post-card-meta">
      <FormattedDate date={published} />
      <span aria-hidden="true">·</span>
      <span>{minutes} min read</span>
    </p>
    <h3 class="post-card-title">{title}</h3>
    <p class="post-card-excerpt">{summary}</p>
  </a>
  {tags.length > 0 && (
    <ul class="post-card-tags">
      {tags.slice(0, 4).map((tag) => (
        <li><a href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a></li>
      ))}
    </ul>
  )}
</article>
