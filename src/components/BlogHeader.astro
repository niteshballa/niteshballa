---
// Shared masthead for the Dev Notes blog zone (serif editorial).
// Lives on the browse pages — posts list, tags, archives, search — so the
// whole blog reads as one world. Reading pages keep their own minimal masthead.
type Props = {
  title?: string; // big serif page title; omit on the posts list
  tagline?: string; // mono line under the masthead / title
  count?: number;
};

const { title, tagline, count } = Astro.props;
---

<header class="bhead col rise">
  <a class="mast" href="/posts/" aria-label="Dev Notes home">
    <span class="prefix mono">~/</span>
    <span class="name">Dev Notes</span>
  </a>

  {
    title && (
      <h1 class="ptitle">
        {title}
        {count != null && <sup class="count">{count}</sup>}
      </h1>
    )
  }
  {tagline && <p class="tagline mono">{tagline}</p>}
</header>

<style>
  .bhead {
    padding-top: clamp(2.5rem, 8vh, 4.5rem);
  }
  .mast {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    text-decoration: none;
  }
  .mast .prefix {
    font-size: 0.95rem;
    color: var(--accent-ink);
  }
  .mast .name {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.4rem;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }

  .ptitle {
    margin: clamp(1.8rem, 5vh, 2.6rem) 0 0;
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(2rem, 5.5vw, 2.8rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--foreground);
  }
  .ptitle .count {
    font-family: var(--mono);
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--accent-ink);
    margin-left: 0.4rem;
    top: -1.1em;
  }

  .tagline {
    margin: 1rem 0 0;
    font-size: 0.84rem;
    letter-spacing: 0.01em;
    color: var(--muted);
  }
</style>
