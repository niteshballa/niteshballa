---
// A single mono row of hard "ship signals" — roles, projects, stack.
// Minimal by design: no boxes, just a bordered strip with dot separators.
interface Item {
  label: string
  href?: string
}
interface Props {
  items: Item[]
}
const { items } = Astro.props
---
<ul class="signal-strip">
  {items.map((item) => (
    <li>
      {item.href ? (
        <a href={item.href} rel="noopener">{item.label}</a>
      ) : (
        <span>{item.label}</span>
      )}
    </li>
  ))}
</ul>
