---
import { getCollection } from "astro:content";
import BlogLayout from "@/layouts/BlogLayout.astro";
import BlogHeader from "@/components/BlogHeader.astro";
import getPostsByGroupCondition from "@/utils/getPostsByGroupCondition";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { SITE } from "@/config";

// Redirect to 404 page if `showArchives` config is false
if (!SITE.showArchives) {
  return Astro.redirect("/404");
}

const posts = getSortedPosts(
  await getCollection("blog", ({ data }) => !data.draft)
);

const months = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
];

const byYear = Object.entries(
  getPostsByGroupCondition(posts, post => post.data.pubDatetime.getFullYear())
).sort(([a], [b]) => Number(b) - Number(a));
---

<BlogLayout
  title={`Archives · ${SITE.blogTitle}`}
  description="Every note, by date."
>
  <main id="main-content" class="page">
    <BlogHeader
      title="Archives"
      tagline="everything I've written, newest first"
      count={posts.length}
    />

    <div class="col body">
      {
        byYear.map(([year, yearGroup]) => (
          <section class="year rise">
            <h2 class="yh">{year}</h2>
            {Object.entries(
              getPostsByGroupCondition(
                yearGroup,
                post => post.data.pubDatetime.getMonth()
              )
            )
              .sort(([a], [b]) => Number(b) - Number(a))
              .map(([month, monthGroup]) => (
                <div class="month">
                  <span class="ml mono">{months[Number(month)]}</span>
                  <ul class="mlist">
                    {monthGroup.map(post => (
                      <li>
                        <a href={getPath(post.id, post.filePath)}>
                          <span class="day mono">
                            {String(post.data.pubDatetime.getDate()).padStart(
                              2,
                              "0"
                            )}
                          </span>
                          <span class="t">{post.data.title}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
          </section>
        ))
      }
    </div>
  </main>
</BlogLayout>

<style>
  .page {
    padding-bottom: 5rem;
    min-height: 80vh;
  }
  .body {
    margin-top: clamp(2rem, 6vh, 3rem);
  }
  .year {
    border-top: 1px solid var(--border);
    padding: 1.8rem 0;
  }
  .yh {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    margin: 0 0 1.2rem;
    color: var(--foreground);
  }
  .month {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.6rem 1rem;
    align-items: baseline;
  }
  .month + .month {
    margin-top: 1.4rem;
  }
  .ml {
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    padding-top: 0.2rem;
  }
  .mlist {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mlist li + li {
    margin-top: 0.7rem;
  }
  .mlist a {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    text-decoration: none;
    color: var(--foreground);
  }
  .day {
    font-size: 0.78rem;
    color: var(--accent-ink);
    flex-shrink: 0;
  }
  .mlist .t {
    font-family: var(--serif);
    font-size: 1.12rem;
    line-height: 1.3;
    transition: color 0.18s;
  }
  .mlist a:hover .t {
    color: var(--accent-ink);
  }

  @media (max-width: 540px) {
    .month {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .ml {
      padding-top: 0;
    }
  }
</style>
