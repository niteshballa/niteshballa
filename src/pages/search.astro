---
import "@pagefind/default-ui/css/ui.css";
import BlogLayout from "@/layouts/BlogLayout.astro";
import BlogHeader from "@/components/BlogHeader.astro";
import { SITE } from "@/config";
---

<BlogLayout
  title={`Search · ${SITE.blogTitle}`}
  description="Search the notes."
>
  <main id="main-content" class="page">
    <BlogHeader title="Search" tagline="find a note" />

    <div class="col body">
      <div id="pagefind-search" transition:persist></div>
    </div>
  </main>
</BlogLayout>

<script>
  function initSearch() {
    const pageFindSearch: HTMLElement | null =
      document.querySelector("#pagefind-search");

    if (!pageFindSearch) return;

    const params = new URLSearchParams(window.location.search);

    const onIdle = window.requestIdleCallback || (cb => setTimeout(cb, 1));

    onIdle(async () => {
      // @ts-expect-error — Missing types for @pagefind/default-ui package.
      const { PagefindUI } = await import("@pagefind/default-ui");

      // Display warning in dev mode
      if (import.meta.env.DEV) {
        pageFindSearch.innerHTML = `
            <div class="dev-warning">
              <p><strong>DEV mode:</strong> run a build at least once to see search results during development.</p>
              <code>pnpm run build</code>
            </div>
          `;
      }

      // Init pagefind ui
      const search = new PagefindUI({
        element: "#pagefind-search",
        showImages: false,
        showSubResults: true,
        processTerm: function (term: string) {
          params.set("q", term); // Update the `q` parameter in the URL
          history.replaceState(history.state, "", "?" + params.toString()); // Push the new URL without reloading
          return term;
        },
      });

      // If search param exists (eg: search?q=astro), trigger search
      const query = params.get("q");
      if (query) {
        search.triggerSearch(query);
      }

      // Reset search param if search input is cleared
      const searchInput = document.querySelector(".pagefind-ui__search-input");
      const clearButton = document.querySelector(".pagefind-ui__search-clear");
      searchInput?.addEventListener("input", resetSearchParam);
      clearButton?.addEventListener("click", resetSearchParam);

      function resetSearchParam(e: Event) {
        if ((e.target as HTMLInputElement)?.value.trim() === "") {
          history.replaceState(history.state, "", window.location.pathname);
        }
      }
    });
  }

  document.addEventListener("astro:after-swap", () => {
    const pagefindSearch = document.querySelector("#pagefind-search");

    // if pagefind search form already exists, don't initialize search component
    if (pagefindSearch && pagefindSearch.querySelector("form")) return;

    initSearch();
  });
  initSearch();
</script>

<style is:global>
  #pagefind-search {
    --pagefind-ui-font: var(--serif);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--background);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-primary: var(--accent-ink);
    --pagefind-ui-tag: var(--panel);
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-image-border-radius: 4px;
    --pagefind-ui-image-box-ratio: 3 / 2;
  }

  #pagefind-search input {
    font-family: var(--mono);
    font-size: 0.95rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--panel);
  }
  #pagefind-search input:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--accent) 22%, transparent);
  }
  #pagefind-search .pagefind-ui__result {
    border-top: 1px solid var(--border);
  }
  #pagefind-search .pagefind-ui__result-title {
    font-family: var(--serif);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  #pagefind-search .pagefind-ui__result-title a {
    color: var(--foreground);
    text-decoration: none;
  }
  #pagefind-search .pagefind-ui__result-title a:hover {
    color: var(--accent-ink);
  }
  #pagefind-search .pagefind-ui__result-excerpt {
    color: var(--muted);
  }
  #pagefind-search mark {
    background: color-mix(in oklch, var(--accent) 24%, transparent);
    color: inherit;
  }
  #pagefind-search .dev-warning {
    border: 1px solid var(--border);
    background: var(--panel);
    border-radius: 8px;
    padding: 1rem 1.2rem;
    margin-bottom: 1rem;
    font-family: var(--mono);
    font-size: 0.84rem;
    color: var(--muted);
  }
  #pagefind-search .dev-warning code {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.2rem 0.5rem;
    background: var(--foreground);
    color: var(--background);
    border-radius: 4px;
  }
</style>

<style>
  .page {
    padding-bottom: 5rem;
    min-height: 80vh;
  }
  .body {
    margin-top: clamp(2rem, 6vh, 3rem);
  }
</style>
