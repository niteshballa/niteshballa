---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import BlogLayout from "@/layouts/BlogLayout.astro";
import BlogHeader from "@/components/BlogHeader.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { readingTime } from "@/utils/readingTime";
import { SITE } from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return paginate(getSortedPosts(posts), { pageSize: 100 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
---

<BlogLayout
  title={`${SITE.blogTitle} · ${SITE.author}`}
  description="Things I figured out, written down before I forget them."
>
  <main id="main-content" class="page">
    <BlogHeader
      tagline="things I figured out, written down before I forget them"
    />

    <div class="col">
      {
        page.data.length === 0 ? (
          <p class="empty">No notes yet. Check back soon.</p>
        ) : (
          <ol class="list">
            {page.data.map((post, i) => (
              <li class="row rise" style={`--d: ${90 + i * 70}ms`}>
                <a href={getPath(post.id, post.filePath)}>
                  <p class="meta mono">
                    {fmt(post.data.pubDatetime)} · {readingTime(post.body)} min
                  </p>
                  <h2 class="t">{post.data.title}</h2>
                  {post.data.description && (
                    <p class="dek">{post.data.description}</p>
                  )}
                  {post.data.tags?.length > 0 && (
                    <p class="tags mono">
                      {post.data.tags.slice(0, 3).map(tag => (
                        <span>#{tag}</span>
                      ))}
                    </p>
                  )}
                </a>
              </li>
            ))}
          </ol>
        )
      }

      <footer class="foot mono">
        <span>© {new Date().getFullYear()} {SITE.author}</span>
        <a href="/rss.xml">RSS</a>
      </footer>
    </div>
  </main>
</BlogLayout>

<style>
  .page {
    padding-bottom: 4rem;
    min-height: 80vh;
  }
  .list {
    list-style: none;
    margin: 2.2rem 0 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .row {
    border-bottom: 1px solid var(--border);
  }
  .row a {
    display: block;
    padding: 1.8rem 0;
    text-decoration: none;
    color: var(--foreground);
  }
  .meta {
    margin: 0;
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .t {
    margin: 0.55rem 0 0;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.45rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--foreground);
    transition: color 0.18s;
  }
  .row a:hover .t {
    color: var(--accent-ink);
  }
  .dek {
    margin: 0.5rem 0 0;
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .tags {
    margin: 0.9rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--accent-ink);
  }
  .empty {
    margin: 2.5rem 0;
    color: var(--muted);
    font-style: italic;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    margin-top: 3rem;
    font-size: 0.74rem;
    color: var(--muted);
  }
  .foot a {
    text-decoration: none;
  }
  .foot a:hover {
    color: var(--accent-ink);
  }
</style>
