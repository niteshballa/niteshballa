---
import Layout from "@/layouts/Layout.astro";

const STACK = ["Rust", "TypeScript", "Kubernetes", "Postgres", "Terraform", "Grafana"];

// Verified from the repo's info.md source-of-truth (recent → earlier).
const EXPERIENCE = [
  { co: "Manif", role: "Forward Deployed Engineer", when: "Now" },
  { co: "GreenBanana", role: "Engineering Lead · Germany", when: "" },
  { co: "Juspay", role: "Product Engineer · Hyperswitch", when: "" },
  { co: "MAQ Software", role: "Engineer", when: "" },
];
---

<Layout>
  <main id="main-content" class="hub" data-layout="index">
    <div class="bento">
      <!-- intro / profile card -->
      <section class="b-card spot cell intro">
        <span class="kicker">// profile</span>
        <h1>Nitesh<br />Balla</h1>
        <p>
          I build the systems that move money and stay up — payment
          orchestration, high-risk processing, and the infrastructure beneath it
          — then embed with the people who depend on them. Backend and infra at
          the core: distributed systems, Kubernetes, observability. Comfortable
          across the stack when a problem needs it.
        </p>
      </section>

      <!-- now -->
      <section class="b-card spot cell now">
        <span class="lbl">// Now</span>
        <div class="big">
          <span class="dot">●</span> Building payment orchestration at Manif.
        </div>
      </section>

      <!-- startup (half) -->
      <a
        class="b-card cell startup"
        href="https://betterswitch.io"
        target="_blank"
        rel="noopener"
      >
        <span class="lbl">// Startup</span>
        <span class="big">betterswitch.io →</span>
      </a>

      <!-- Dev Notes (half) — the notes are their own world (different design
           zone), so open in a new tab like an external destination -->
      <a class="b-card cell blog" href="/posts/" target="_blank" rel="noopener">
        <span class="lbl">// Writing</span>
        <span class="big">Dev Notes →</span>
      </a>

      <!-- stack (half) -->
      <section class="b-card spot cell stack">
        <span class="lbl">// Stack</span>
        <div class="chips">{STACK.map(s => <span>{s}</span>)}</div>
      </section>

      <!-- quote (half) -->
      <section class="b-card spot cell quote">
        <span class="q">"The unglamorous plumbing is the product."</span>
      </section>

      <!-- experience -->
      <section class="b-card spot cell exp">
        <span class="lbl">// Experience</span>
        <ul class="xp">
          {
            EXPERIENCE.map(job => (
              <li>
                <span class="co">{job.co}</span>
                <span class="ro">{job.role}</span>
                <span class="yr">{job.when}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </main>
</Layout>

<style>
  .hub {
    width: 100%;
    max-width: 1040px;
    margin-inline: auto;
    padding: 14px clamp(1rem, 4vw, 2rem) 0;
  }
  .bento {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    grid-auto-rows: minmax(86px, auto);
    font-family: var(--font-mono);
  }
  .cell {
    padding: clamp(1rem, 2vw, 1.5rem);
  }
  .lbl {
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* intro */
  .intro {
    grid-column: span 2;
    grid-row: span 3;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    color: inherit;
  }
  .intro .kicker {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .intro h1 {
    font-family: var(--font-app);
    font-weight: 700;
    font-size: clamp(2.6rem, 6.5vw, 4.6rem);
    line-height: 0.86;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    margin: 0.6rem 0 0.5rem;
  }
  .intro .role {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-ink);
    letter-spacing: 0.02em;
    max-width: none;
    margin-bottom: 0.9rem;
  }
  .intro p {
    font-family: var(--font-app);
    font-weight: 500;
    font-size: 1.08rem;
    line-height: 1.55;
    color: var(--muted);
    max-width: 42ch;
  }

  /* startup + blog — two compact half-width link cards, side by side */
  .startup,
  .blog {
    grid-column: span 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
  }
  .startup .big,
  .blog .big {
    font-family: var(--font-app);
    font-weight: 700;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    letter-spacing: -0.01em;
    word-break: break-word;
  }
  .startup .lbl,
  .blog .lbl {
    color: var(--background);
    opacity: 0.7;
  }
  /* startup = terracotta, default ink shadow */
  .startup {
    background: var(--accent-ink);
    color: var(--background);
  }
  .startup:hover {
    box-shadow: 6px 6px 0 var(--ink);
  }
  /* blog = black with an orange shadow */
  .blog {
    background: var(--ink);
    color: var(--background);
    box-shadow: 4px 4px 0 var(--accent);
  }
  .blog:hover {
    box-shadow: 6px 6px 0 var(--accent);
  }

  /* stack (half) */
  .stack {
    grid-column: span 1;
  }
  .stack .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.7rem;
  }
  .stack .chips span {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.03em;
    border: 1.5px solid var(--ink);
    padding: 0.16rem 0.5rem;
    color: var(--foreground);
  }

  /* quote (half) */
  .quote {
    grid-column: span 1;
    display: flex;
    align-items: center;
  }
  .quote .q {
    font-family: var(--font-app);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.3;
  }

  /* now */
  .now {
    grid-column: span 2;
  }
  .now .big {
    font-family: var(--font-app);
    font-weight: 500;
    font-size: 1.05rem;
    margin-top: 0.4rem;
    line-height: 1.25;
  }
  .now .dot {
    color: var(--accent);
  }

  /* experience — full-width horizontal timeline */
  .exp {
    grid-column: span 4;
  }
  .xp {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
  }
  .xp li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--ink);
  }
  .xp .co {
    font-family: var(--font-app);
    font-weight: 700;
    font-size: 1rem;
    color: var(--foreground);
  }
  .xp .ro {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
    letter-spacing: 0.02em;
    line-height: 1.4;
  }
  .xp .yr {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-ink);
  }

  @media (max-width: 740px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
    /* full-width blocks; the half-cards (startup/blog/stack/quote) stay
       span-1 so they keep pairing 2-up */
    .intro,
    .now,
    .exp {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .intro {
      grid-row: auto;
    }
    .xp {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  // subtle terracotta pointer-spotlight on cards
  function initSpotlight() {
    document.querySelectorAll<HTMLElement>(".b-card.spot").forEach(card => {
      card.addEventListener("pointermove", e => {
        const r = card.getBoundingClientRect();
        card.style.setProperty("--x", `${e.clientX - r.left}px`);
        card.style.setProperty("--y", `${e.clientY - r.top}px`);
      });
    });
  }
  document.addEventListener("astro:page-load", () => {
    initSpotlight();
    const indexLayout = (
      document.querySelector("#main-content") as HTMLElement
    )?.dataset?.layout;
    if (indexLayout) sessionStorage.setItem("backUrl", "/");
  });
</script>
