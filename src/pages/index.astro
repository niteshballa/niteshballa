---
import Base from '../layouts/Base.astro'
import PostPreview from '../components/PostPreview.astro'
import SignalStrip from '../components/SignalStrip.astro'
import { getCollection } from 'astro:content'
import { SITE } from '../consts'

// Hard ship signals (facts already stated across the site).
const signals = [
  { label: 'FDE @ Manif', href: 'https://manif.ai' },
  { label: 'Payments @ Juspay' },
  { label: 'Rust · TypeScript · Kubernetes' },
]

const posts = (await getCollection('posts', (p) => !p.data.draft)).sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime(),
)
---
<Base>
  <section class="intro">
    <h1 class="intro-title">Nitesh Balla</h1>
    <p class="intro-lead">{SITE.tagline}</p>
    <p class="intro-body">
      Forward Deployed Engineer at <a href="https://manif.ai">Manif</a>, where we
      build the financial infrastructure and control plane for agentic commerce —
      embedding with customers and shipping systems that hold up in production.
      Previously led engineering at GreenBanana Group and built payment systems at
      Juspay, including core contributions to
      <a href="https://github.com/juspay/hyperswitch">Hyperswitch</a>. I write
      about payment systems, infrastructure, and the trade-offs underneath them.
    </p>
  </section>

  <SignalStrip items={signals} />

  <section class="home-section">
    <div class="section-head">
      <h2 class="section-title">Focus</h2>
    </div>
    <dl class="focus-list">
      <div class="focus-item">
        <dt>AI-native engineering</dt>
        <dd>Building with LLMs, agents, and evals — shipping, not demoing.</dd>
      </div>
      <div class="focus-item">
        <dt>Forward-deployed delivery</dt>
        <dd>Embedding with customers, building against real constraints.</dd>
      </div>
      <div class="focus-item">
        <dt>Payments</dt>
        <dd>SDKs, integrations, and dashboards that hold up in production.</dd>
      </div>
    </dl>
  </section>

  <section class="archive">
    <div class="section-head">
      <h2 class="section-title">Writing</h2>
    </div>
    <div class="post-feed">
      {posts.map((post) => <PostPreview post={post} />)}
    </div>
  </section>
</Base>
