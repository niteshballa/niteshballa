---
import { render, type CollectionEntry } from "astro:content";
import BlogLayout from "@/layouts/BlogLayout.astro";
import { getPath } from "@/utils/getPath";
import { readingTime } from "@/utils/readingTime";
import { SITE } from "@/config";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;
const { title, description, pubDatetime, tags } = post.data;
const { Content } = await render(post);

const mins = readingTime(post.body);
const dateStr = pubDatetime.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});

const idx = posts.findIndex(p => p.id === post.id);
const newer = idx > 0 ? posts[idx - 1] : null;
const older = idx >= 0 && idx < posts.length - 1 ? posts[idx + 1] : null;
---

<BlogLayout title={`${title} · ${SITE.blogTitle}`} description={description}>
  <div id="progress" aria-hidden="true"></div>

  <header class="col topbar">
    <a class="mast" href="/posts/">
      <span class="prefix">~/</span>
      <span class="name">Dev Notes</span>
    </a>
  </header>

  <article class="col post">
    <p class="meta mono">{dateStr} · {mins} min</p>
    <h1>{title}</h1>
    {description && <p class="dek">{description}</p>}
    {
      tags?.length > 0 && (
        <p class="tags mono">
          {tags.map(t => <span>#{t}</span>)}
        </p>
      )
    }
    <div class="rule"></div>

    <div class="prose">
      <Content />
    </div>

    {
      (newer || older) && (
        <nav class="postnav">
          <div>
            {newer && (
              <a href={getPath(newer.id, newer.filePath)}>
                <span class="lbl mono">Newer</span>
                <span class="t">{newer.data.title}</span>
              </a>
            )}
          </div>
          <div class="r">
            {older && (
              <a href={getPath(older.id, older.filePath)}>
                <span class="lbl mono">Older</span>
                <span class="t">{older.data.title}</span>
              </a>
            )}
          </div>
        </nav>
      )
    }

    <footer class="foot mono">
      <a href="/posts/">~/ all notes</a>
      <span>© {new Date().getFullYear()} {SITE.author}</span>
    </footer>
  </article>
</BlogLayout>

<style>
  .topbar {
    padding-top: clamp(2rem, 6vh, 3rem);
  }
  .mast {
    text-decoration: none;
  }
  .mast .name {
    font-size: 1.3rem;
  }

  .post {
    padding-top: clamp(2.5rem, 9vh, 5rem);
    padding-bottom: 4rem;
  }
  .meta {
    margin: 0 0 0.9rem;
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .post h1 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(2rem, 5vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--foreground);
  }
  .dek {
    margin: 1.1rem 0 0;
    font-size: 1.3rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .tags {
    margin: 1.1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    font-size: 0.72rem;
    color: var(--accent-ink);
  }
  .rule {
    height: 1px;
    background: var(--border);
    margin-top: clamp(2rem, 6vh, 3rem);
  }
  .prose {
    margin-top: clamp(2rem, 5vh, 2.8rem);
  }

  .postnav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 4rem;
    padding-top: 1.8rem;
    border-top: 1px solid var(--border);
  }
  .postnav .r {
    text-align: right;
  }
  .postnav a {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--foreground);
  }
  .postnav .lbl {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .postnav .t {
    font-family: var(--serif);
    font-size: 1.15rem;
    line-height: 1.25;
  }
  .postnav a:hover .t {
    color: var(--accent-ink);
  }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.8rem;
    color: var(--muted);
    font-size: 0.74rem;
  }
  .foot a {
    text-decoration: none;
  }
  .foot a:hover {
    color: var(--accent-ink);
  }

  #progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0;
    background: var(--accent);
    z-index: 50;
    transition: width 0.1s linear;
  }

  @media (max-width: 540px) {
    .postnav {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }
    .postnav .r {
      text-align: left;
    }
  }
</style>

<script is:inline>
  (function () {
    // One document-level listener for the page's lifetime; it re-queries the
    // bar each tick, so it survives view-transition swaps without stacking
    // duplicate listeners on every navigation.
    if (window.__progressBarBound) return;
    window.__progressBarBound = true;
    const onScroll = () => {
      const bar = document.getElementById("progress");
      if (!bar) return;
      const h =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const pct = h > 0 ? (document.documentElement.scrollTop / h) * 100 : 0;
      bar.style.width = pct + "%";
    };
    document.addEventListener("scroll", onScroll, { passive: true });
    document.addEventListener("astro:page-load", onScroll);
    onScroll();
  })();
</script>
