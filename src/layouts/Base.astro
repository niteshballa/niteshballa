---
import '../styles/global.css'
import { SITE, NAV, SOCIALS } from '../consts'
import ThemeToggle from '../components/ThemeToggle.astro'
import avatar from '../content/avatar.jpg'

interface Props {
  title?: string
  description?: string
  type?: 'website' | 'article'
  publishedTime?: Date
  modifiedTime?: Date
  articleTags?: string[]
}
const {
  title,
  description = SITE.description,
  type = 'website',
  publishedTime,
  modifiedTime,
  articleTags = [],
} = Astro.props
const pageTitle = title ? `${title} — ${SITE.title}` : SITE.title
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL(avatar.src, Astro.site)
const year = new Date().getFullYear()
const path = Astro.url.pathname
const isActive = (href: string) => path === href || path.startsWith(href + '/')

// Structured data: a BlogPosting for articles, otherwise the site author (Person).
const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        url: canonical.href,
        mainEntityOfPage: canonical.href,
        image: ogImage.href,
        datePublished: publishedTime?.toISOString(),
        dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
        keywords: articleTags.length ? articleTags.join(', ') : undefined,
        author: { '@type': 'Person', name: SITE.author, url: SITE.url },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: SITE.author,
        url: SITE.url,
        image: ogImage.href,
        description: SITE.description,
        sameAs: [SOCIALS.github, SOCIALS.linkedin],
      }
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fcfcfa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#14130f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..650&family=Hanken+Grotesk:wght@400..700&display=swap"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={SITE.author} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    {type === 'article' && articleTags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Apply theme before paint to avoid a flash of the wrong theme. -->
    <script is:inline>
      const stored = localStorage.getItem('theme')
      if (stored === 'dark' || (!stored && matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark')
      }
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <a href="/" class="brand">{SITE.title}</a>
      <nav>
        {NAV.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
        <ThemeToggle />
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <span>© {year} {SITE.author}</span>
      <span class="footer-links">
        <a href={SOCIALS.github}>GitHub</a>
        <a href={SOCIALS.linkedin}>LinkedIn</a>
        <a href="/rss.xml">RSS</a>
      </span>
    </footer>
  </body>
</html>
