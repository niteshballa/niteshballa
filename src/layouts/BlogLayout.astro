---
import { ClientRouter } from "astro:transitions";
import { SITE } from "@/config";
import "@/styles/tokens.css";

type Props = {
  title?: string;
  description?: string;
};

const { title = SITE.title, description = SITE.desc } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap"
      rel="stylesheet"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", Astro.site)}
    />
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* ── Dev Notes · serif editorial. Palette/fonts come from tokens.css ── */
  * {
    box-sizing: border-box;
  }
  html {
    background: var(--background);
    scrollbar-gutter: stable;
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    color: var(--foreground);
    background: var(--background);
    font-family: var(--serif);
    font-size: 1.15rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  ::selection {
    background: color-mix(in oklch, var(--accent) 28%, transparent);
  }
  a {
    color: inherit;
  }
  a:focus-visible,
  button:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .col {
    width: 100%;
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }
  .mono {
    font-family: var(--mono);
  }

  /* ── masthead (shared) ── */
  .mast {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
  }
  .mast .prefix {
    font-family: var(--mono);
    font-size: 1rem;
    color: var(--accent-ink);
  }
  .mast .name {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.7rem;
    letter-spacing: -0.01em;
    color: var(--foreground);
    text-decoration: none;
  }

  /* ── prose ── */
  .prose {
    font-size: 1.2rem;
    line-height: 1.72;
    color: color-mix(in oklch, var(--foreground) 92%, var(--muted));
  }
  .prose > * + * {
    margin-top: 1.3em;
  }
  .prose h2,
  .prose h3,
  .prose h4 {
    font-family: var(--serif);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.01em;
    color: var(--foreground);
    margin-top: 1.9em;
    margin-bottom: 0.1em;
  }
  .prose h2 {
    font-size: 1.6rem;
  }
  .prose h3 {
    font-size: 1.3rem;
  }
  .prose a {
    color: var(--foreground);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--accent);
  }
  .prose a:hover {
    color: var(--accent-ink);
  }
  .prose strong {
    font-weight: 600;
  }
  .prose em {
    font-style: italic;
  }
  .prose ul,
  .prose ol {
    padding-left: 1.3em;
  }
  .prose li + li {
    margin-top: 0.4em;
  }
  .prose li::marker {
    color: var(--accent);
  }
  .prose blockquote {
    margin-inline: 0;
    padding-left: 1.2em;
    border-left: 2px solid var(--accent);
    font-style: italic;
    color: var(--muted);
  }
  .prose :not(pre) > code {
    font-family: var(--mono);
    font-size: 0.78em;
    background: var(--panel);
    border: 1px solid var(--border);
    padding: 0.08em 0.36em;
    border-radius: 3px;
  }
  .prose pre {
    font-family: var(--mono);
    font-size: 0.82rem;
    line-height: 1.6;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow-x: auto;
    background: var(--shiki-light-bg, var(--panel));
  }
  .prose pre,
  .prose pre span {
    color: var(--shiki-light, var(--foreground));
  }
  .prose pre code {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
  }
  .prose img {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .prose hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.2em 0;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .rise {
    animation: rise 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: var(--d, 0ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .rise {
      animation: none;
    }
  }
</style>
