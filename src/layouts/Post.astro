---
import Base from './Base.astro'
import FormattedDate from '../components/FormattedDate.astro'
import Toc from '../components/Toc.astro'
import readingTime from 'reading-time'
import type { CollectionEntry } from 'astro:content'
import type { MarkdownHeading } from 'astro'

interface Props {
  post: CollectionEntry<'posts'>
  newer?: CollectionEntry<'posts'> | null
  older?: CollectionEntry<'posts'> | null
  related?: CollectionEntry<'posts'>[]
  headings?: MarkdownHeading[]
}
const {
  post,
  newer = null,
  older = null,
  related = [],
  headings = [],
} = Astro.props
const { title, description, published, updated, tags } = post.data
const minutes = Math.max(1, Math.round(readingTime(post.body ?? '').minutes))
// A TOC is only worthwhile with a couple of sections.
const showToc = headings.filter((h) => h.depth === 2 || h.depth === 3).length > 1
---
<Base
  title={title}
  description={description}
  type="article"
  publishedTime={published}
  modifiedTime={updated}
  articleTags={tags}
>
  <div class="reading-progress" aria-hidden="true"></div>

  <article class="post">
    <header class="post-header">
      <h1>{title}</h1>
      <p class="post-meta">
        <FormattedDate date={published} />
        <span>·</span>
        <span>{minutes} min read</span>
        {updated && (
          <>
            <span>·</span>
            <span>updated <FormattedDate date={updated} /></span>
          </>
        )}
      </p>
      {tags.length > 0 && (
        <p class="post-tags">
          {tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a>)}
        </p>
      )}
    </header>

    {showToc && (
      <details class="toc-inline">
        <summary>On this page</summary>
        <Toc headings={headings} />
      </details>
    )}

    <div class="prose">
      <slot />
    </div>

    <footer class="post-footer">
      {related.length > 0 && (
        <section class="related" aria-label="Related posts">
          <h2 class="related-title">Related</h2>
          <ul class="related-list">
            {related.map((r) => (
              <li><a href={`/posts/${r.id}`}>{r.data.title}</a></li>
            ))}
          </ul>
        </section>
      )}

      {(newer || older) && (
        <nav class="post-nav" aria-label="More posts">
          {older ? (
            <a href={`/posts/${older.id}`} class="post-nav-link prev" rel="prev">
              <span class="post-nav-label">← Previous</span>
              <span class="post-nav-title">{older.data.title}</span>
            </a>
          ) : <span />}
          {newer ? (
            <a href={`/posts/${newer.id}`} class="post-nav-link next" rel="next">
              <span class="post-nav-label">Next →</span>
              <span class="post-nav-title">{newer.data.title}</span>
            </a>
          ) : <span />}
        </nav>
      )}
      <a href="/" class="back">← All posts</a>
    </footer>
  </article>

  {showToc && (
    <aside class="toc-rail">
      <p class="toc-title">On this page</p>
      <Toc headings={headings} />
    </aside>
  )}

  <script is:inline>
    ;(function () {
      // Reading progress bar (width-based, rAF-throttled).
      var bar = document.querySelector('.reading-progress')
      if (bar) {
        var ticking = false
        var update = function () {
          var el = document.documentElement
          var max = el.scrollHeight - el.clientHeight
          bar.style.width = (max > 0 ? (el.scrollTop / max) * 100 : 0) + '%'
          ticking = false
        }
        addEventListener(
          'scroll',
          function () {
            if (!ticking) {
              ticking = true
              requestAnimationFrame(update)
            }
          },
          { passive: true },
        )
        update()
      }

      // Copy buttons for code blocks.
      document.querySelectorAll('.prose pre').forEach(function (pre) {
        var wrap = document.createElement('div')
        wrap.className = 'code-wrap'
        pre.parentNode.insertBefore(wrap, pre)
        wrap.appendChild(pre)

        var btn = document.createElement('button')
        btn.type = 'button'
        btn.className = 'copy-btn'
        btn.textContent = 'Copy'
        btn.addEventListener('click', function () {
          var code = pre.querySelector('code')
          var text = code ? code.innerText : pre.innerText
          navigator.clipboard.writeText(text).then(
            function () {
              btn.textContent = 'Copied'
              setTimeout(function () {
                btn.textContent = 'Copy'
              }, 1500)
            },
            function () {
              btn.textContent = 'Error'
            },
          )
        })
        wrap.appendChild(btn)
      })
    })()
  </script>
</Base>
